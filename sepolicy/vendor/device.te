# SpacemiT device types

# I2C device
type i2c_device, dev_type;

# SPI device
type spidev_device, dev_type;

# GPIO device
type gpio_device, dev_type;

# eMMC boot partition
type emmc_boot_block_device, dev_type;

# RPMB block device
type rpmb_block_device, dev_type;

# AVB (vbmeta) block device
type vbmeta_block_device, dev_type;

# Persist block device
type persist_block_device, dev_type;
allow persist_block_device labeledfs:filesystem associate;

# RFKill device (WiFi/Bluetooth RF control)
type rfkill_device, dev_type;

# DMA-BUF CMA heap device
type dmabuf_cma_heap_device, dmabuf_heap_device_type, dev_type;

# Vendor sysfs types
type sysfs_mmc, fs_type, sysfs_type;
type sysfs_vpu, fs_type, sysfs_type;
