<!--
     boot/health/fastboot/power/keymint/gatekeeper each ship their own
     VINTF fragment alongside their init.rc (via their Android.bp
     vintf_fragments), so this device-level manifest doesn't need to
     redeclare them. Only HALs without a fragment are listed here.
-->
<manifest version="1.0" type="device" target-level="202404">
    <!-- External USB camera HAL (AIDL) -->
    <hal format="aidl">
        <name>android.hardware.camera.provider</name>
        <version>1</version>
        <fqname>ICameraProvider/external/0</fqname>
    </hal>
</manifest>
